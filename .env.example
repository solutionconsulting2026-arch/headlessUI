# OpenAI API key used to generate a React UI from MCP tool results.
OPENAI_API_KEY=sk-...

# Optional: override the model used for routing and UI generation (defaults to gpt-4o).
OPENAI_MODEL=gpt-4o

# Optional: default MCP server URL pre-filled in the UI.
NEXT_PUBLIC_DEFAULT_MCP_SERVER_URL=https://headlessmcp.vercel.app/mcp
